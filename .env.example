# ─────────────────────────────────────────────────────────────
# Knowledge Adventurer 环境变量示例
# 复制本文件为 .env 并填入真实值：  cp .env.example .env
# ⚠️ 切勿把 .env 提交到 Git（已在 .gitignore 中排除）
# ─────────────────────────────────────────────────────────────

# PostgreSQL 连接串（docker-compose 默认）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/knowledge_adventurer?schema=public"

# DeepSeek API（仅后端使用，绝不出现在前端代码中）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# JWT 签名密钥 —— 请改成足够长的随机字符串
JWT_SECRET="please-change-me-to-a-long-random-secret-string"

# 应用地址
NEXT_PUBLIC_APP_URL="http://localhost:3000"
